# EC2 서버 /home/ubuntu/app/.env 에 이 파일을 복사하고 실제 값 입력
# 절대 Git에 커밋하지 말 것

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://<RDS-ENDPOINT>:3306/officemeong?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=
KTO_SERVICE_KEY=

# 카카오 로그인 (developers.kakao.com > 앱 키 > REST API 키)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

# JWT 서명 키 (32자 이상 임의 문자열)
JWT_SECRET=

# 관리자 배치 수동 실행 API 키 (미설정 시 /api/v1/admin/** 전체 503으로 차단됨)
# 호출 시 요청 헤더에 X-Admin-Key: <이 값> 을 포함해야 함
ADMIN_API_KEY=

# OpenAI API (AI 추천 기능)
OPENAI_API_KEY=

# AWS S3 (반려견 사진 업로드)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# 앱 정책/문의 링크 (미설정 시 플레이스홀더 URL 사용)
TERMS_URL=
PRIVACY_URL=
INQUIRY_URL=
